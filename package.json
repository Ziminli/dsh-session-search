{
  "name": "dsh-session-search",
  "version": "1.3.6",
  "description": "Search stored DSH conversation text across all or selected workspaces and sessions, with exact, regular-expression, typo-tolerant or word-internal subsequence matching.",
  "type": "module",
  "license": "MIT",
  "author": "Zimin Li",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ziminli/dsh-session-search.git"
  },
  "homepage": "https://github.com/Ziminli/dsh-session-search#readme",
  "bugs": {"url": "https://github.com/Ziminli/dsh-session-search/issues"},
  "keywords": ["dsh-plugin", "dsh", "session-search", "conversation-search"],
  "engines": {"node": ">=22"},
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "settings.js",
    "search.js",
    "session-catalog.js",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "docs/community-listing.yml",
    "LICENSE"
  ],
  "scripts": {
    "check": "node tools/check.mjs",
    "test": "node --test search.test.js fuzzy.test.js filters.test.js settings.test.js client-logic.test.js highlight.test.js"
  },
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-plugin-manager"]
    }
  }
}
